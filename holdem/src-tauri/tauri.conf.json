{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Texas Holdem",
  "version": "1.0.1",
  "identifier": "mx.blackjack21.holdem",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Texas Hold'em",
        "fullscreen": true,
        "width": 1366,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4QTc3QjY1MjU4Q0E0OEUKUldTT3BJd2xaWHVuMlB4TUZrL3JlVkxIRVdqelVETGdqWFZ5TVlydTJRNi9RTVI0VUJ2M3lZZVkK",
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
